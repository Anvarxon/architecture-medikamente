<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="C2. Движок классификации данных" id="d1102001851">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bgov" value="Governance и наблюдаемость" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#2E7D32;fontColor=#2E7D32;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="1914" y="110" width="312" height="1016" as="geometry"/></mxCell>
        <mxCell id="bdwh" value="Аналитическое хранилище (слои)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B8860B;fontColor=#B8860B;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="1534" y="110" width="312" height="1016" as="geometry"/></mxCell>
        <mxCell id="beng" value="Data Classification Engine (система в фокусе)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1072" height="1016" as="geometry"/></mxCell>
        <mxCell id="bsrc" value="Источники данных" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#2E6295;fontColor=#2E6295;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="14" y="110" width="312" height="1016" as="geometry"/></mxCell>
        <mxCell id="t_title" value="C4, уровень 2 (контейнеры) — Data Classification Engine: классификация данных перед пакетной загрузкой в аналитическое хранилище" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Вход: источники с неразмеченной и меняющейся структурой (Excel, сканы, 1С, CDC из сервисов, партнёрские API). Выход: данные, разложенные по слоям хранилища в соответствии с классом конфиденциальности, с тегами и lineage." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Ключевой принцип: ни один набор данных не попадает в слои, доступные аналитикам, до того как он классифицирован и обработан по политике своего класса." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="s1" value="Файловые источники&lt;br&gt;[Excel, CSV, PDF, JPG]&lt;br&gt;исторические журналы,&lt;br&gt;сканы, реестры" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="s2" value="Операционные БД&lt;br&gt;[PostgreSQL, CDC Debezium]&lt;br&gt;запись, ЭМК, платежи" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="s3" value="1С:Бухгалтерия&lt;br&gt;и 1С:Торговля&lt;br&gt;[OData / выгрузки]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="s4" value="Партнёрские API&lt;br&gt;[лаборатория, эквайринг]&lt;br&gt;JSON-ответы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="s5" value="Логи и события&lt;br&gt;[Kafka, Audit Log]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="ing" value="1. Ingest Service&lt;br&gt;[Airflow / NiFi, Spark]&lt;br&gt;пакетная загрузка, чек-суммы,&lt;br&gt;дедупликация, идемпотентность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="land" value="2. Landing Zone (Raw-Restricted)&lt;br&gt;[S3, шифрование SSE-KMS]&lt;br&gt;изолированная карантинная зона,&lt;br&gt;доступ только сервисным УЗ" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="drift" value="3. Schema Registry&lt;br&gt;+ Drift Detector&lt;br&gt;[Avro/JSON Schema]&lt;br&gt;обнаружение новых и изменённых&lt;br&gt;полей, версионирование схем" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="prof" value="4. Data Profiler&lt;br&gt;[Spark]&lt;br&gt;статистики, сэмплирование,&lt;br&gt;форматы значений, кардинальность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="780" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="meta" value="5. Metadata Store&lt;br&gt;[PostgreSQL]&lt;br&gt;схемы, профили, версии правил,&lt;br&gt;история решений" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="rule" value="6. Rule Classifier&lt;br&gt;[регулярные выражения, словари,&lt;br&gt;контрольные суммы]&lt;br&gt;СНИЛС, ИНН, паспорт, полис ОМС,&lt;br&gt;телефон, e-mail, коды МКБ-10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="ml" value="7. ML/NLP Classifier&lt;br&gt;[NER-модель, эмбеддинги]&lt;br&gt;свободный текст анамнеза,&lt;br&gt;имена, адреса, диагнозы&lt;br&gt;в неструктурированных полях" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="ctx" value="8. Context Classifier&lt;br&gt;[графовые правила]&lt;br&gt;учёт связей: обезличенное поле&lt;br&gt;становится ПДн в связке&lt;br&gt;с другими атрибутами" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="score" value="9. Scoring &amp; Decision&lt;br&gt;[взвешенное голосование]&lt;br&gt;итоговый класс + уверенность,&lt;br&gt;порог автоприменения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="780" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="hitl" value="10. Steward Review UI&lt;br&gt;[Human-in-the-loop]&lt;br&gt;разбор спорных случаев,&lt;br&gt;обучающая обратная связь" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="policy" value="11. Policy Engine&lt;br&gt;[OPA / Rego]&lt;br&gt;правило «класс → действие»:&lt;br&gt;маскировать, токенизировать,&lt;br&gt;обобщить, не грузить" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="mask" value="12. Masking &amp; Tokenization&lt;br&gt;[Vault Transform, Spark UDF]&lt;br&gt;хеширование, токены,&lt;br&gt;обобщение квазиидентификаторов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="quar" value="13. Quarantine&lt;br&gt;[S3, отдельный ключ KMS]&lt;br&gt;нераспознанные и низкоуверенные&lt;br&gt;данные, доступ только DPO" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="load" value="14. Loader&lt;br&gt;[Spark → ClickHouse / Iceberg]&lt;br&gt;запись в целевой слой,&lt;br&gt;проставление тегов и lineage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="780" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="qual" value="15. Quality &amp; Metrics&lt;br&gt;[Great Expectations]&lt;br&gt;проверки качества,&lt;br&gt;метрики классификации" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="l0" value="Слой 0. Raw-Restricted&lt;br&gt;сырые данные как есть,&lt;br&gt;шифрование, доступ только&lt;br&gt;сервисным учётным записям" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="l1" value="Слой 1. Cleansed-Pseudonymized&lt;br&gt;прямые идентификаторы&lt;br&gt;заменены токенами,&lt;br&gt;доступ по роли и цели" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="l2" value="Слой 2. Curated-Anonymized&lt;br&gt;обобщённые квазиидентификаторы,&lt;br&gt;k-анонимность ≥ 5,&lt;br&gt;доступ аналитикам" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="l3" value="Слой 3. Marts / Feature Store&lt;br&gt;витрины BI, признаки для ML,&lt;br&gt;агрегаты без ПДн" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="780" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="l4" value="Слой 4. Sandbox&lt;br&gt;песочница для гипотез&lt;br&gt;только на данных слоёв 2–3" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cat" value="Data Catalog + Tagging&lt;br&gt;[DataHub / OpenMetadata]&lt;br&gt;справочник классов,&lt;br&gt;владельцы данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="lin" value="Data Lineage&lt;br&gt;происхождение поля,&lt;br&gt;получатели, срок хранения" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="audit" value="Audit Log (WORM)&lt;br&gt;кто, что и на каком основании&lt;br&gt;читал данные" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="mon" value="Мониторинг и алертинг&lt;br&gt;[VictoriaMetrics, Grafana]&lt;br&gt;метрики качества классификации" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="780" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="dpo" value="Офицер ИБ / DPO&lt;br&gt;и владельцы данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1940" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="e_s1_1" value="пакетная&lt;br&gt;загрузка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_s2_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_s3_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_s4_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_s5_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="ing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ing_6" value="сырые данные&lt;br&gt;в карантин" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ing" target="land"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_land_7" value="разбор структуры" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="land" target="drift"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_drift_8" value="схема + версия" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="drift" target="prof"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_prof_9" value="профили и статистики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prof" target="meta"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_prof_10" value="выборка значений&lt;br&gt;и метаданные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prof" target="rule"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="835"/><mxPoint x="740" y="205"/></Array><mxPoint as="offset" x="0" y="-40"/></mxGeometry></mxCell>
        <mxCell id="e_rule_11" value="поля без&lt;br&gt;однозначного правила" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rule" target="ml"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ml_12" value="кандидаты&lt;br&gt;и вероятности" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ml" target="ctx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ctx_13" value="оценки классов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx" target="score"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_score_14" value="низкая уверенность&lt;br&gt;(&lt; порога)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="score" target="hitl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
