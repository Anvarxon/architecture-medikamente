        <mxCell id="e_doc_3" value="F1.3 просмотр своего&lt;br&gt;расписания [C1, C2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="doc" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_4" value="проверка токена OIDC [C2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gw" target="iam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_5" value="решение о доступе [C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gw" target="pdp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_6" value="F1.4 запрос по контракту&lt;br&gt;OpenAPI [C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="appt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_appt_7" value="проверка согласия&lt;br&gt;и цели [C9]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="appt" target="consent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_appt_8" value="F1.5 сохранить ПДн,&lt;br&gt;получить токен [C4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="appt" target="vault"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_appt_9" value="F1.6 запись:&lt;br&gt;token_id + слот [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="appt" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_vault_10" value="F1.7 шифрование&lt;br&gt;полей [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vault" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_appt_11" value="F1.8 событие доступа [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="appt" target="audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_audit_12" value="поток событий,&lt;br&gt;детект аномалий [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="audit" target="siem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_13" value="F1.9 записи на завтра&lt;br&gt;(токены, без ПДн)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="notif"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_notif_14" value="F1.10 шаблон уведомления,&lt;br&gt;номер получен по токену [C4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="notif" target="chan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_15" value="F1.11 CDC-поток" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="cdc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_cdc_16" value="F1.12 обезличенные&lt;br&gt;данные [C6, C10]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdc" target="lake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_chan_17" value="F1.13 напоминание, подтверждение или отмена записи" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="chan" target="pat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2070" y="800"/><mxPoint x="170" y="800"/></Array><mxPoint as="offset" x="-560" y="0"/></mxGeometry></mxCell>
        <mxCell id="note_ctl" value="КАТАЛОГ МЕР ЗАЩИТЫ (ссылки [Cn] на стрелках)&lt;br&gt;C1  TLS 1.3 (ГОСТ TLS для внешних каналов) + mTLS между сервисами&lt;br&gt;C2  Аутентификация OIDC (Keycloak) + MFA, отказ от общих учётных записей&lt;br&gt;C3  Авторизация ABAC/RBAC через PDP (OPA): проверка «свой пациент / своя запись»&lt;br&gt;C4  Токенизация и псевдонимизация ПДн в PII Vault (прямые идентификаторы → токен)&lt;br&gt;C5  Шифрование at rest: TDE + шифрование полей (pgcrypto / SSE-KMS), ключи в KMS/HSM&lt;br&gt;C6  Маскирование и обезличивание для аналитики и нижних сред&lt;br&gt;C7  Неизменяемый журнал доступа (WORM, hash-chain) → SIEM, алертинг на аномалии&lt;br&gt;C8  DLP: контроль выгрузок, запрет массового экспорта, водяные знаки&lt;br&gt;C9  Consent Service: согласие, цель обработки, отзыв, срок хранения и авто-удаление&lt;br&gt;C10 Data Catalog: тегирование данных (класс конфиденциальности) и Data Lineage&lt;br&gt;C11 Contract-first API: OpenAPI + валидация схемы, rate limit, квоты, no bulk export&lt;br&gt;C12 Сегментация сети (Zero Trust), приватные подсети, доступ только через шлюз" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1180" height="250" as="geometry"/></mxCell>
        <mxCell id="note_legend" value="ЛЕГЕНДА&lt;br&gt;• Синий прямоугольник — внешняя сущность   • Зелёный овал — процесс (микросервис)&lt;br&gt;• Жёлтый прямоугольник — хранилище данных   • Красный — внешняя система&lt;br&gt;• Фиолетовый пунктирный — компонент безопасности (control)&lt;br&gt;• Синяя стрелка — поток данных с указанием применённых мер [Cn]&lt;br&gt;• Фиолетовая пунктирная стрелка — управляющий поток (политика, аудит, ключи)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="780" height="140" as="geometry"/></mxCell>
        <mxCell id="note_res" value="ЧТО ИЗМЕНИЛОСЬ ОТНОСИТЕЛЬНО AS-IS&lt;br&gt;&lt;br&gt;R1.1 → доступ только через API и PDP: сотрудник&lt;br&gt;видит записи своего филиала и своей роли,&lt;br&gt;выгрузка списка пациентов невозможна.&lt;br&gt;&lt;br&gt;R1.2 → каждое обращение к ПДн пишется&lt;br&gt;в неизменяемый журнал и уходит в SIEM.&lt;br&gt;&lt;br&gt;R1.3 → TLS 1.3 in transit, TDE и шифрование&lt;br&gt;полей at rest, ключи в KMS/HSM.&lt;br&gt;&lt;br&gt;R1.4 → согласие и цель обработки хранятся&lt;br&gt;в Consent Service и проверяются при каждом&lt;br&gt;вызове API.&lt;br&gt;&lt;br&gt;R1.5 → уведомления идут через сервис с договором&lt;br&gt;поручения; личные телефоны сотрудников&lt;br&gt;исключены из процесса, DLP блокирует выгрузки.&lt;br&gt;&lt;br&gt;R1.6 → срок хранения задан в Consent Service;&lt;br&gt;удаление по запросу субъекта выполняется&lt;br&gt;уничтожением ключа и токена (crypto-shredding).&lt;br&gt;&lt;br&gt;R1.7 → персональные учётные записи и MFA,&lt;br&gt;общие учётные записи запрещены политикой." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="430" height="620" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. TO-BE. Приём и ЭМК" id="d3870762447">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b1" value="Периметр платформы (C12). Поля класса «специальная категория ПДн» помечены тегами каталога (C10)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1452" height="596" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 2 (TO-BE). Электронная медицинская карта (ЭМК) и работа с документами" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Медицинские данные хранятся отдельно от прямых идентификаторов, связь — только через токен пациента. Доступ врача ограничен правилом «свой пациент» и подтверждённым эпизодом лечения." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Аварийный доступ break-glass разрешён, но требует обоснования и порождает алерт в SIEM." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="doc" value="Медицинский специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pat" value="Пациент (ЛК)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="dpo" value="Офицер ИБ / DPO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="gw" value="API Gateway + WAF&lt;br&gt;TLS 1.3, mTLS C1, C11" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pdp" value="PDP: OPA&lt;br&gt;«свой пациент», эпизод лечения,&lt;br&gt;break-glass C3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="dlp" value="DLP + водяные знаки&lt;br&gt;контроль выгрузок C8" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="emr" value="1.0 EMR Service&lt;br&gt;осмотры, диагнозы, назначения" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="docsvc" value="2.0 Document Service&lt;br&gt;загрузка и выдача файлов" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="vault" value="PII Vault&lt;br&gt;token_id ↔ ПДн C4" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d1" value="D1 | PostgreSQL EMR&lt;br&gt;данные по token_id,&lt;br&gt;шифрование полей C5" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d2" value="D2 | S3 Object Storage&lt;br&gt;SSE-KMS, версии,&lt;br&gt;объекты по token_id C5" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="catalog" value="Data Catalog&lt;br&gt;теги классов данных C10" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="audit" value="D3 | Audit Log (WORM)&lt;br&gt;доступ к врачебной тайне C7" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="ret" value="3.0 Retention Service&lt;br&gt;сроки хранения, удаление C9" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cdc" value="4.0 ETL → Data Lake&lt;br&gt;обезличивание C6" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="siem" value="SIEM + алертинг" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="kms" value="KMS / HSM&lt;br&gt;ключи и их ротация" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="lake" value="D4 | Data Lake:&lt;br&gt;обезличенный слой" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1940" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="e_doc_1" value="F2.1 осмотр, диагноз&lt;br&gt;[C1, C2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="doc" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_pat_2" value="F2.2 просмотр только&lt;br&gt;своих данных [C1, C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_3" value="решение о доступе [C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gw" target="pdp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_4" value="F2.3 запись эпизода [C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="emr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_emr_5" value="F2.4 сохранение&lt;br&gt;по token_id [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="emr" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_6" value="F2.5 загрузка скана [C1]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="docsvc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_docsvc_7" value="F2.6 объект без ПДн&lt;br&gt;в имени [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="docsvc" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_docsvc_8" value="теги класса данных [C10]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="docsvc" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_emr_9" value="разрешение token_id → ПДн&lt;br&gt;только при наличии права [C4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="emr" target="vault"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="205"/><mxPoint x="1120" y="625"/></Array><mxPoint as="offset" x="0" y="-40"/></mxGeometry></mxCell>
        <mxCell id="e_emr_10" value="F2.7 событие доступа [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="emr" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="310"/><mxPoint x="1690" y="310"/></Array><mxPoint as="offset" x="-120" y="0"/></mxGeometry></mxCell>
        <mxCell id="e_audit_11" value="алерт на нетипичный&lt;br&gt;доступ [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="audit" target="siem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_dlp_12" value="F2.8 контроль выгрузок,&lt;br&gt;блокировка массового экспорта [C8]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="dlp" target="docsvc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_dpo_13" value="разбор инцидентов&lt;br&gt;и политики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="dpo" target="dlp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_14" value="F2.9 истёк срок хранения&lt;br&gt;→ удаление [C9]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="ret"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_kms_15" value="ключи шифрования и ротация [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="kms" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2070" y="520"/><mxPoint x="1310" y="520"/></Array><mxPoint as="offset" x="100" y="0"/></mxGeometry></mxCell>
        <mxCell id="e_d1_16" value="F2.10 выгрузка в аналитику" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="cdc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="205"/><mxPoint x="1500" y="625"/></Array><mxPoint as="offset" x="0" y="-30"/></mxGeometry></mxCell>
        <mxCell id="e_cdc_17" value="F2.11 обезличенные&lt;br&gt;данные [C6, C10]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdc" target="lake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="note_ctl" value="КАТАЛОГ МЕР ЗАЩИТЫ (ссылки [Cn] на стрелках)&lt;br&gt;C1  TLS 1.3 (ГОСТ TLS для внешних каналов) + mTLS между сервисами&lt;br&gt;C2  Аутентификация OIDC (Keycloak) + MFA, отказ от общих учётных записей&lt;br&gt;C3  Авторизация ABAC/RBAC через PDP (OPA): проверка «свой пациент / своя запись»&lt;br&gt;C4  Токенизация и псевдонимизация ПДн в PII Vault (прямые идентификаторы → токен)&lt;br&gt;C5  Шифрование at rest: TDE + шифрование полей (pgcrypto / SSE-KMS), ключи в KMS/HSM&lt;br&gt;C6  Маскирование и обезличивание для аналитики и нижних сред&lt;br&gt;C7  Неизменяемый журнал доступа (WORM, hash-chain) → SIEM, алертинг на аномалии&lt;br&gt;C8  DLP: контроль выгрузок, запрет массового экспорта, водяные знаки&lt;br&gt;C9  Consent Service: согласие, цель обработки, отзыв, срок хранения и авто-удаление&lt;br&gt;C10 Data Catalog: тегирование данных (класс конфиденциальности) и Data Lineage&lt;br&gt;C11 Contract-first API: OpenAPI + валидация схемы, rate limit, квоты, no bulk export&lt;br&gt;C12 Сегментация сети (Zero Trust), приватные подсети, доступ только через шлюз" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1180" height="250" as="geometry"/></mxCell>
        <mxCell id="note_legend" value="ЛЕГЕНДА&lt;br&gt;• Синий прямоугольник — внешняя сущность   • Зелёный овал — процесс (микросервис)&lt;br&gt;• Жёлтый прямоугольник — хранилище данных   • Красный — внешняя система&lt;br&gt;• Фиолетовый пунктирный — компонент безопасности (control)&lt;br&gt;• Синяя стрелка — поток данных с указанием применённых мер [Cn]&lt;br&gt;• Фиолетовая пунктирная стрелка — управляющий поток (политика, аудит, ключи)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="780" height="140" as="geometry"/></mxCell>
        <mxCell id="note_res" value="ЧТО ИЗМЕНИЛОСЬ ОТНОСИТЕЛЬНО AS-IS&lt;br&gt;&lt;br&gt;R2.1 → в именах объектов и каталогов нет ПДн:&lt;br&gt;используется token_id, ФИО раскрывается&lt;br&gt;только через PII Vault при наличии права.&lt;br&gt;&lt;br&gt;R2.2 → правило «врач видит только своих пациентов»&lt;br&gt;реализовано политикой ABAC в PDP; аварийный&lt;br&gt;доступ break-glass требует обоснования.&lt;br&gt;&lt;br&gt;R2.3 → буфер МФУ заменён Document Service:&lt;br&gt;скан сразу попадает в объектное хранилище&lt;br&gt;с шифрованием и тегами.&lt;br&gt;&lt;br&gt;R2.4 → DLP блокирует массовые выгрузки,&lt;br&gt;файлы маркируются водяным знаком с логином.&lt;br&gt;&lt;br&gt;R2.5 → шифрование на уровне полей и объектов,&lt;br&gt;ключи в KMS/HSM с регулярной ротацией.&lt;br&gt;&lt;br&gt;R2.6 → полный аудит доступа к врачебной тайне,&lt;br&gt;алерты в SIEM на аномальные обращения.&lt;br&gt;&lt;br&gt;R2.7 → электронное согласие связано с записью;&lt;br&gt;Retention Service удаляет данные по сроку&lt;br&gt;и по отзыву согласия.&lt;br&gt;&lt;br&gt;R2.8 → аналитика работает только&lt;br&gt;с обезличенным слоем Data Lake." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="430" height="620" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. TO-BE. Договор и оплата" id="d3712962636">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b1" value="Периметр платформы (C12): финансовый контур сегментирован от медицинского" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1072" height="596" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 3 (TO-BE). Договор, платёжный шлюз и учёт выручки" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Финансовый контур не получает медицинскую номенклатуру: наружу отдаётся обезличенный код услуги. Двойной учёт в Excel исключён, 1С получает данные только через интеграционную шину." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Данные карт не проходят через системы компании: используется платёжный провайдер и токен карты — это сокращает зону PCI DSS." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="pat" value="Пациент (ЛК / касса)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cas" value="Кассир&lt;br&gt;(персональная УЗ, MFA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="acc" value="Бухгалтер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="gw" value="API Gateway + WAF&lt;br&gt;TLS 1.3 C1, C11" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pdp" value="PDP: OPA&lt;br&gt;роли «касса», «бухгалтерия» C3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="mask" value="Data Masking Service&lt;br&gt;услуга → обезличенный код C6" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pay" value="1.0 Payment Gateway&lt;br&gt;счёт, оплата, возврат" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="contract" value="2.0 Contract Service&lt;br&gt;договор и электронная подпись" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="fin" value="3.0 Billing / финансовый учёт&lt;br&gt;выручка по коду услуги" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d1" value="D1 | PostgreSQL payments&lt;br&gt;token_id, код услуги, сумма&lt;br&gt;TDE C5" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d2" value="D2 | S3: договоры&lt;br&gt;SSE-KMS, ЭП, ретеншен C5, C9" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="audit" value="D3 | Audit Log (WORM) C7" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="psp" value="Платёжный провайдер&lt;br&gt;(токен карты, PCI DSS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="kkm" value="ККМ / ОФД&lt;br&gt;через защищённый шлюз" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="bus" value="4.0 Интеграционная шина&lt;br&gt;(Kafka + адаптер 1С)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="siem" value="SIEM + алертинг" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="odin" value="1С:Бухгалтерия&lt;br&gt;(клиент-серверный режим)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="e_pat_1" value="F3.1 оплата в ЛК [C1]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_cas_2" value="F3.2 оплата на кассе&lt;br&gt;[C1, C2]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cas" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_3" value="проверка роли [C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gw" target="pdp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_4" value="F3.3 создание счёта [C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_pay_5" value="F3.4 платёж: токен карты,&lt;br&gt;данные карты не хранятся" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="psp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="310"/><mxPoint x="1690" y="310"/></Array><mxPoint as="offset" x="-60" y="0"/></mxGeometry></mxCell>
        <mxCell id="e_pay_6" value="F3.5 фискализация [C1, mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="kkm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="344"/><mxPoint x="1690" y="344"/></Array><mxPoint as="offset" x="170" y="-14"/></mxGeometry></mxCell>
        <mxCell id="e_pay_7" value="F3.6 платёж:&lt;br&gt;token_id + код услуги [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gw_8" value="F3.7 договор и подписание" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="contract"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_contract_9" value="F3.8 PDF с ЭП [C5, C9]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="contract" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_mask_10" value="F3.9 обезличенный&lt;br&gt;код услуги [C6]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="mask" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_fin_11" value="F3.10 агрегаты выручки без ПДн" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fin" target="bus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="730"/><mxPoint x="1690" y="730"/></Array><mxPoint as="offset" x="-60" y="0"/></mxGeometry></mxCell>
        <mxCell id="e_bus_12" value="F3.11 проводки через API&lt;br&gt;[C1, C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="odin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_acc_13" value="F3.12 доступ бухгалтера:&lt;br&gt;только финансовые атрибуты [C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="mask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_pay_14" value="F3.13 событие [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="pay" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="205"/><mxPoint x="1120" y="625"/></Array><mxPoint as="offset" x="0" y="-30"/></mxGeometry></mxCell>
        <mxCell id="e_audit_15" value="алертинг на аномалии [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="audit" target="siem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="520"/><mxPoint x="2070" y="520"/></Array><mxPoint as="offset" x="120" y="0"/></mxGeometry></mxCell>
        <mxCell id="note_ctl" value="КАТАЛОГ МЕР ЗАЩИТЫ (ссылки [Cn] на стрелках)&lt;br&gt;C1  TLS 1.3 (ГОСТ TLS для внешних каналов) + mTLS между сервисами&lt;br&gt;C2  Аутентификация OIDC (Keycloak) + MFA, отказ от общих учётных записей&lt;br&gt;C3  Авторизация ABAC/RBAC через PDP (OPA): проверка «свой пациент / своя запись»&lt;br&gt;C4  Токенизация и псевдонимизация ПДн в PII Vault (прямые идентификаторы → токен)&lt;br&gt;C5  Шифрование at rest: TDE + шифрование полей (pgcrypto / SSE-KMS), ключи в KMS/HSM&lt;br&gt;C6  Маскирование и обезличивание для аналитики и нижних сред&lt;br&gt;C7  Неизменяемый журнал доступа (WORM, hash-chain) → SIEM, алертинг на аномалии&lt;br&gt;C8  DLP: контроль выгрузок, запрет массового экспорта, водяные знаки&lt;br&gt;C9  Consent Service: согласие, цель обработки, отзыв, срок хранения и авто-удаление&lt;br&gt;C10 Data Catalog: тегирование данных (класс конфиденциальности) и Data Lineage&lt;br&gt;C11 Contract-first API: OpenAPI + валидация схемы, rate limit, квоты, no bulk export&lt;br&gt;C12 Сегментация сети (Zero Trust), приватные подсети, доступ только через шлюз" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1180" height="250" as="geometry"/></mxCell>
        <mxCell id="note_legend" value="ЛЕГЕНДА&lt;br&gt;• Синий прямоугольник — внешняя сущность   • Зелёный овал — процесс (микросервис)&lt;br&gt;• Жёлтый прямоугольник — хранилище данных   • Красный — внешняя система&lt;br&gt;• Фиолетовый пунктирный — компонент безопасности (control)&lt;br&gt;• Синяя стрелка — поток данных с указанием применённых мер [Cn]&lt;br&gt;• Фиолетовая пунктирная стрелка — управляющий поток (политика, аудит, ключи)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="780" height="140" as="geometry"/></mxCell>
        <mxCell id="note_res" value="ЧТО ИЗМЕНИЛОСЬ ОТНОСИТЕЛЬНО AS-IS&lt;br&gt;&lt;br&gt;R3.1 и R3.2 → касса и бухгалтерия видят только&lt;br&gt;обезличенный код услуги и сумму: связка&lt;br&gt;«ФИО + диагноз» в финансовом контуре исключена.&lt;br&gt;&lt;br&gt;R3.3 → 1С переводится в клиент-серверный режим,&lt;br&gt;прямой доступ к файлу базы закрыт,&lt;br&gt;обмен идёт через интеграционную шину по API.&lt;br&gt;&lt;br&gt;R3.4 → двойной учёт в Excel ликвидирован,&lt;br&gt;единый источник истины — сервис Billing.&lt;br&gt;&lt;br&gt;R3.5 → канал до ККМ защищён TLS и mTLS,&lt;br&gt;фискализация выполняется через шлюз, а не OLE.&lt;br&gt;&lt;br&gt;R3.6 → персональные учётные записи с MFA,&lt;br&gt;каждая операция привязана к сотруднику.&lt;br&gt;&lt;br&gt;R3.7 → заданы сроки хранения договоров,&lt;br&gt;удаление автоматизировано (C9).&lt;br&gt;&lt;br&gt;R3.8 → финансовый и медицинский контуры&lt;br&gt;разнесены по сегментам сети (C12)." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="430" height="620" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. TO-BE. Интеграция с лабораторией" id="d4119165859">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b2" value="Внешний контур: лаборатория. Поручение на обработку по ст. 6 ч. 3 152-ФЗ, mTLS, IP allow-list" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;fontColor=#B85450;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="1534" y="110" width="692" height="386" as="geometry"/></mxCell>
        <mxCell id="b1" value="Периметр платформы (C12)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1072" height="596" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 4 (TO-BE). API-интеграция с лабораторией анализов" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Контракт закрывает конфиденциальные категории: наружу уходит псевдоним заказа, пол и возраст, а не ФИО, дата рождения и телефон. Массовая выгрузка реестра невозможна архитектурно." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Шаблон контракта (OpenAPI + теги полей + поручение на обработку) переиспользуется для новых партнёров без перевалидации." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="doc" value="Медицинский специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pat" value="Пациент (ЛК)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
