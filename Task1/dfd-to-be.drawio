  <diagram name="1. TO-BE. Запись на приём" id="d2754037353">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b1" value="Периметр платформы: приватные подсети Kubernetes, доступ только через API Gateway (C12)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1452" height="596" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 1 (TO-BE). Самостоятельная запись пациента через личный кабинет и портал ресепшена" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Privacy by Design: прямые идентификаторы отделены от медицинского контекста, доступ — только через шлюз и PDP, каждое обращение к ПДн журналируется." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="MVP (2 месяца): портал пациента, портал ресепшена, сервис записи, напоминания. Финал (1 год): мобильное приложение и голосовой робот." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="pat" value="Пациент&lt;br&gt;(веб-ЛК / мобильное приложение)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="rec" value="Сотрудник ресепшена&lt;br&gt;(портал ресепшена)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="doc" value="Медицинский специалист&lt;br&gt;(портал врача)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="iam" value="IAM: Keycloak&lt;br&gt;OIDC + MFA, SSO C2" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="gw" value="API Gateway + WAF&lt;br&gt;TLS 1.3, mTLS, rate limit,&lt;br&gt;валидация схемы C1, C11" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pdp" value="PDP: OPA&lt;br&gt;политики ABAC / RBAC C3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="consent" value="Consent Service&lt;br&gt;согласие, цель, отзыв C9" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="appt" value="1.0 Appointment Service&lt;br&gt;запись, слоты, статусы" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="vault" value="PII Vault + KMS/HSM&lt;br&gt;токенизация ФИО и телефона C4" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="audit" value="D3 | Audit Log (WORM)&lt;br&gt;кто, что, когда, зачем C7" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d1" value="D1 | PostgreSQL appointments&lt;br&gt;token_id, слот, код услуги&lt;br&gt;TDE + RLS C5" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d2" value="D2 | PII Vault storage&lt;br&gt;шифрованные ПДн C5" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="notif" value="2.0 Notification Service&lt;br&gt;напоминание и подтверждение" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cdc" value="3.0 CDC → Data Lake&lt;br&gt;обезличивание C6" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="siem" value="SIEM + алертинг&lt;br&gt;(Elastic, Victoria Metrics)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="chan" value="Push / SMS / голосовой робот&lt;br&gt;(договор поручения)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1940" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="lake" value="D4 | Data Lake:&lt;br&gt;обезличенный слой C6, C10" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1940" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="e_pat_1" value="F1.1 запись на приём&lt;br&gt;[C1, C9]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
