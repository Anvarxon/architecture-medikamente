        <mxCell id="e_proc_8" value="F5.7 счета и накладные [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_catalog_9" value="теги «коммерческая&lt;br&gt;тайна» [C10]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="catalog" target="proc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_mask_10" value="F5.8 обезличенное списание без привязки к пациенту [C6]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mask" target="lake"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="730"/><mxPoint x="1690" y="730"/></Array><mxPoint as="offset" x="-40" y="0"/></mxGeometry></mxCell>
        <mxCell id="e_d1_11" value="F5.9 данные для учёта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_bus_12" value="F5.10 проводки по API&lt;br&gt;[C1, C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="odin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_acc_13" value="F5.11 аналитика затрат&lt;br&gt;без медицинского контекста [C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="mask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wms_14" value="F5.12 событие [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="wms" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="205"/><mxPoint x="1120" y="625"/></Array><mxPoint as="offset" x="0" y="-30"/></mxGeometry></mxCell>
        <mxCell id="e_audit_15" value="алертинг на аномалии [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="audit" target="siem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="520"/><mxPoint x="2070" y="520"/></Array><mxPoint as="offset" x="120" y="0"/></mxGeometry></mxCell>
        <mxCell id="note_ctl" value="КАТАЛОГ МЕР ЗАЩИТЫ (ссылки [Cn] на стрелках)&lt;br&gt;C1  TLS 1.3 (ГОСТ TLS для внешних каналов) + mTLS между сервисами&lt;br&gt;C2  Аутентификация OIDC (Keycloak) + MFA, отказ от общих учётных записей&lt;br&gt;C3  Авторизация ABAC/RBAC через PDP (OPA): проверка «свой пациент / своя запись»&lt;br&gt;C4  Токенизация и псевдонимизация ПДн в PII Vault (прямые идентификаторы → токен)&lt;br&gt;C5  Шифрование at rest: TDE + шифрование полей (pgcrypto / SSE-KMS), ключи в KMS/HSM&lt;br&gt;C6  Маскирование и обезличивание для аналитики и нижних сред&lt;br&gt;C7  Неизменяемый журнал доступа (WORM, hash-chain) → SIEM, алертинг на аномалии&lt;br&gt;C8  DLP: контроль выгрузок, запрет массового экспорта, водяные знаки&lt;br&gt;C9  Consent Service: согласие, цель обработки, отзыв, срок хранения и авто-удаление&lt;br&gt;C10 Data Catalog: тегирование данных (класс конфиденциальности) и Data Lineage&lt;br&gt;C11 Contract-first API: OpenAPI + валидация схемы, rate limit, квоты, no bulk export&lt;br&gt;C12 Сегментация сети (Zero Trust), приватные подсети, доступ только через шлюз" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1180" height="250" as="geometry"/></mxCell>
        <mxCell id="note_legend" value="ЛЕГЕНДА&lt;br&gt;• Синий прямоугольник — внешняя сущность   • Зелёный овал — процесс (микросервис)&lt;br&gt;• Жёлтый прямоугольник — хранилище данных   • Красный — внешняя система&lt;br&gt;• Фиолетовый пунктирный — компонент безопасности (control)&lt;br&gt;• Синяя стрелка — поток данных с указанием применённых мер [Cn]&lt;br&gt;• Фиолетовая пунктирная стрелка — управляющий поток (политика, аудит, ключи)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="780" height="140" as="geometry"/></mxCell>
        <mxCell id="note_res" value="ЧТО ИЗМЕНИЛОСЬ ОТНОСИТЕЛЬНО AS-IS&lt;br&gt;&lt;br&gt;R5.1 → списания обезличиваются до аналитики:&lt;br&gt;связка «препарат + кабинет + дата» больше&lt;br&gt;не позволяет восстановить диагноз пациента.&lt;br&gt;&lt;br&gt;R5.2 → цены и условия поставщиков помечены&lt;br&gt;тегом «коммерческая тайна», доступ по роли.&lt;br&gt;&lt;br&gt;R5.3 → OLE-обмен заменён интеграционной шиной&lt;br&gt;с аутентификацией и журналированием.&lt;br&gt;&lt;br&gt;R5.4 → 1С в клиент-серверном режиме:&lt;br&gt;разграничение прав и масштабирование&lt;br&gt;на филиалы и рост объёма данных.&lt;br&gt;&lt;br&gt;R5.5 → ПДн контактных лиц поставщиков учтены&lt;br&gt;в реестре обработки, основание — договор.&lt;br&gt;&lt;br&gt;R5.6 → первичные документы в объектном&lt;br&gt;хранилище с версионированием и шифрованием." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="430" height="620" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. TO-BE. Кадры и зарплата" id="d4085280795">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
