        <mxCell id="e_hr_5" value="F6.4 паспорт и СНИЛС&lt;br&gt;в токен [C4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="hr" target="vault"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="205"/><mxPoint x="1120" y="625"/></Array><mxPoint as="offset" x="0" y="-40"/></mxGeometry></mxCell>
        <mxCell id="e_hr_6" value="F6.5 скан&lt;br&gt;в хранилище [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hr" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_hr_7" value="F6.6 кадровые данные [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hr" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_8" value="F6.7 данные&lt;br&gt;для расчёта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="pay"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-34"/></mxGeometry></mxCell>
        <mxCell id="e_pay_9" value="F6.8 реестр по каналу с ЭП, без промежуточных файлов [C1]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="bank"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="520"/><mxPoint x="1690" y="520"/></Array><mxPoint as="offset" x="-40" y="0"/></mxGeometry></mxCell>
        <mxCell id="e_pay_10" value="F6.9 регламентированная&lt;br&gt;отчётность" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pay" target="bus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="344"/><mxPoint x="1690" y="344"/></Array><mxPoint as="offset" x="150" y="-14"/></mxGeometry></mxCell>
        <mxCell id="e_bus_11" value="F6.10 отчётность&lt;br&gt;по ТКС [C1]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bus" target="fns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ret_12" value="F6.11 удаление ПДн по истечении&lt;br&gt;срока: уничтожение токена [C9]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ret" target="vault"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_hr_13" value="F6.12 событие доступа [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="hr" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="205"/><mxPoint x="1190" y="625"/></Array><mxPoint as="offset" x="0" y="110"/></mxGeometry></mxCell>
        <mxCell id="e_audit_14" value="алерт на массовое&lt;br&gt;чтение сканов [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="audit" target="siem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_dpo_15" value="контроль сроков&lt;br&gt;и оснований" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="dpo" target="ret"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="note_ctl" value="КАТАЛОГ МЕР ЗАЩИТЫ (ссылки [Cn] на стрелках)&lt;br&gt;C1  TLS 1.3 (ГОСТ TLS для внешних каналов) + mTLS между сервисами&lt;br&gt;C2  Аутентификация OIDC (Keycloak) + MFA, отказ от общих учётных записей&lt;br&gt;C3  Авторизация ABAC/RBAC через PDP (OPA): проверка «свой пациент / своя запись»&lt;br&gt;C4  Токенизация и псевдонимизация ПДн в PII Vault (прямые идентификаторы → токен)&lt;br&gt;C5  Шифрование at rest: TDE + шифрование полей (pgcrypto / SSE-KMS), ключи в KMS/HSM&lt;br&gt;C6  Маскирование и обезличивание для аналитики и нижних сред&lt;br&gt;C7  Неизменяемый журнал доступа (WORM, hash-chain) → SIEM, алертинг на аномалии&lt;br&gt;C8  DLP: контроль выгрузок, запрет массового экспорта, водяные знаки&lt;br&gt;C9  Consent Service: согласие, цель обработки, отзыв, срок хранения и авто-удаление&lt;br&gt;C10 Data Catalog: тегирование данных (класс конфиденциальности) и Data Lineage&lt;br&gt;C11 Contract-first API: OpenAPI + валидация схемы, rate limit, квоты, no bulk export&lt;br&gt;C12 Сегментация сети (Zero Trust), приватные подсети, доступ только через шлюз" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1180" height="250" as="geometry"/></mxCell>
        <mxCell id="note_legend" value="ЛЕГЕНДА&lt;br&gt;• Синий прямоугольник — внешняя сущность   • Зелёный овал — процесс (микросервис)&lt;br&gt;• Жёлтый прямоугольник — хранилище данных   • Красный — внешняя система&lt;br&gt;• Фиолетовый пунктирный — компонент безопасности (control)&lt;br&gt;• Синяя стрелка — поток данных с указанием применённых мер [Cn]&lt;br&gt;• Фиолетовая пунктирная стрелка — управляющий поток (политика, аудит, ключи)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="780" height="140" as="geometry"/></mxCell>
        <mxCell id="note_res" value="ЧТО ИЗМЕНИЛОСЬ ОТНОСИТЕЛЬНО AS-IS&lt;br&gt;&lt;br&gt;R6.1 → домен HR описан в реестре обработки:&lt;br&gt;перечень данных, цели, основания, сроки.&lt;br&gt;&lt;br&gt;R6.2 → сканы паспортов и СНИЛС в шифрованном&lt;br&gt;объектном хранилище с доступом по роли,&lt;br&gt;а не на общем сетевом диске.&lt;br&gt;&lt;br&gt;R6.3 → зарплатный реестр уходит в банк&lt;br&gt;по защищённому каналу с ЭП, промежуточные&lt;br&gt;файлы на файловой системе не создаются.&lt;br&gt;&lt;br&gt;R6.4 → медицинские книжки помечены как&lt;br&gt;специальная категория ПДн, доступ ограничен.&lt;br&gt;&lt;br&gt;R6.5 → процессы автоматизированы и выдерживают&lt;br&gt;рост штата в 5 раз без роста ручного труда.&lt;br&gt;&lt;br&gt;R6.6 → Retention Service удаляет ПДн уволенных&lt;br&gt;по истечении срока, факт удаления журналируется.&lt;br&gt;&lt;br&gt;R6.7 → роли HR, расчётчика и аудитора разделены&lt;br&gt;(segregation of duties)." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="430" height="620" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
