        <mxCell id="e_gw_3" value="F4.2 создание заказа [C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gw" target="order"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_order_4" value="F4.3 псевдоним заказа:&lt;br&gt;без ФИО и телефона [C4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="order" target="vault"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_order_5" value="F4.4 заказ: псевдоним,&lt;br&gt;пол, возраст, перечень&lt;br&gt;исследований [C4, C11]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.38;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="order" target="egress"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_order_6" value="F4.5 заказ&lt;br&gt;по token_id [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="order" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_egress_7" value="F4.6 вызов API партнёра&lt;br&gt;[C1, mTLS, подпись]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="egress" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_lab_8" value="F4.7 callback с результатом&lt;br&gt;[C1, mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="egress"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_egress_9" value="F4.8 результат&lt;br&gt;по псевдониму" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="egress" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_res_10" value="F4.9 результат&lt;br&gt;по token_id [C5]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_res_11" value="теги: специальная&lt;br&gt;категория ПДн [C10]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="res" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_egress_12" value="F4.10 журнал обращений [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="egress" target="audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_audit_13" value="алерт на всплеск&lt;br&gt;запросов [C7]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="audit" target="siem"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_egress_14" value="F4.11 фиксация состава&lt;br&gt;переданных полей [C10]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="egress" target="lineage"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="205"/><mxPoint x="1500" y="625"/></Array><mxPoint as="offset" x="0" y="-30"/></mxGeometry></mxCell>
        <mxCell id="e_d1_15" value="F4.12 пациент видит только свои результаты [C3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="pat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="415"/><mxPoint x="1120" y="800"/><mxPoint x="170" y="800"/></Array><mxPoint as="offset" x="-260" y="0"/></mxGeometry></mxCell>
        <mxCell id="note_ctl" value="КАТАЛОГ МЕР ЗАЩИТЫ (ссылки [Cn] на стрелках)&lt;br&gt;C1  TLS 1.3 (ГОСТ TLS для внешних каналов) + mTLS между сервисами&lt;br&gt;C2  Аутентификация OIDC (Keycloak) + MFA, отказ от общих учётных записей&lt;br&gt;C3  Авторизация ABAC/RBAC через PDP (OPA): проверка «свой пациент / своя запись»&lt;br&gt;C4  Токенизация и псевдонимизация ПДн в PII Vault (прямые идентификаторы → токен)&lt;br&gt;C5  Шифрование at rest: TDE + шифрование полей (pgcrypto / SSE-KMS), ключи в KMS/HSM&lt;br&gt;C6  Маскирование и обезличивание для аналитики и нижних сред&lt;br&gt;C7  Неизменяемый журнал доступа (WORM, hash-chain) → SIEM, алертинг на аномалии&lt;br&gt;C8  DLP: контроль выгрузок, запрет массового экспорта, водяные знаки&lt;br&gt;C9  Consent Service: согласие, цель обработки, отзыв, срок хранения и авто-удаление&lt;br&gt;C10 Data Catalog: тегирование данных (класс конфиденциальности) и Data Lineage&lt;br&gt;C11 Contract-first API: OpenAPI + валидация схемы, rate limit, квоты, no bulk export&lt;br&gt;C12 Сегментация сети (Zero Trust), приватные подсети, доступ только через шлюз" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1180" height="250" as="geometry"/></mxCell>
        <mxCell id="note_legend" value="ЛЕГЕНДА&lt;br&gt;• Синий прямоугольник — внешняя сущность   • Зелёный овал — процесс (микросервис)&lt;br&gt;• Жёлтый прямоугольник — хранилище данных   • Красный — внешняя система&lt;br&gt;• Фиолетовый пунктирный — компонент безопасности (control)&lt;br&gt;• Синяя стрелка — поток данных с указанием применённых мер [Cn]&lt;br&gt;• Фиолетовая пунктирная стрелка — управляющий поток (политика, аудит, ключи)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="780" height="140" as="geometry"/></mxCell>
        <mxCell id="note_res" value="ЧТО ИЗМЕНИЛОСЬ ОТНОСИТЕЛЬНО AS-IS&lt;br&gt;&lt;br&gt;R4.1 → массовая выгрузка исключена: API работает&lt;br&gt;по одному заказу, действуют квоты и rate limit,&lt;br&gt;bulk-эндпоинтов в контракте нет.&lt;br&gt;&lt;br&gt;R4.2 → минимизация по умолчанию: партнёр получает&lt;br&gt;псевдоним, пол и возраст; ФИО, дата рождения&lt;br&gt;и телефон не покидают периметр.&lt;br&gt;&lt;br&gt;R4.3 → канал защищён mTLS и подписью запроса,&lt;br&gt;IP allow-list, есть подтверждение доставки.&lt;br&gt;&lt;br&gt;R4.4 → общие почтовые ящики не используются:&lt;br&gt;результат приходит callback-ом в сервис,&lt;br&gt;а не человеку на почту.&lt;br&gt;&lt;br&gt;R4.5 → Data Lineage фиксирует, какие поля,&lt;br&gt;кому и когда переданы: ответ на запрос субъекта&lt;br&gt;формируется автоматически.&lt;br&gt;&lt;br&gt;R4.6 → контракт-шаблон (OpenAPI + теги полей)&lt;br&gt;переиспользуется для новых партнёров,&lt;br&gt;перевалидация не требуется.&lt;br&gt;&lt;br&gt;R4.7 → пациент получает результат в ЛК после&lt;br&gt;аутентификации, а не «на руки без проверки»." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2300" y="120" width="430" height="620" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. TO-BE. Учёт ТМЦ и закупки" id="d243450533">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b1" value="Периметр платформы и сегмент back-office (C12)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1072" height="596" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 5 (TO-BE). Закупки, приёмка и списание товарно-материальных ценностей" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="1С переводится в клиент-серверный режим, прямой доступ к файлам баз закрыт. Списание препаратов обезличивается до попадания в аналитику, чтобы исключить реидентификацию пациента." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Цены и условия поставщиков помечаются тегом «коммерческая тайна» и доступны только по роли." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="wh" value="Сотрудник склада&lt;br&gt;(персональная УЗ, MFA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="doc" value="Медицинский специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="acc" value="Бухгалтер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="gw" value="API Gateway&lt;br&gt;TLS 1.3 C1, C11" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pdp" value="PDP: OPA&lt;br&gt;роли «склад», «бухгалтерия» C3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="catalog" value="Data Catalog&lt;br&gt;тег «коммерческая тайна» C10" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="wms" value="1.0 Складской сервис&lt;br&gt;заявки, приёмка, списание" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="proc" value="2.0 Закупочный сервис&lt;br&gt;заказы поставщикам" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="mask" value="Обезличивание списаний:&lt;br&gt;препарат → группа,&lt;br&gt;без привязки к пациенту C6" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d1" value="D1 | 1С:Торговля и склад&lt;br&gt;клиент-серверный режим,&lt;br&gt;доступ по ролям C3, C5" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
