        <mxCell id="b1" value="Граница доверия: ЛВС офиса; \\FS\HR; 1С:Бухгалтерия в файловом режиме" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;fontColor=#B85450;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="692" height="806" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 6 (AS-IS). Кадровый учёт, расчёт заработной платы и отчётность" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Категории данных: ПДн сотрудников (паспорт, СНИЛС, ИНН, адрес), специальная категория ПДн (медицинская книжка, справки), банковская тайна (зарплатный реестр)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Правовой контекст: 152-ФЗ, ТК РФ гл. 14, 395-1 (банковская тайна). При росте штата в 5 раз объём ПДн растёт пропорционально." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="emp" value="Кандидат / сотрудник&lt;br&gt;(35 чел., план — рост ×5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="acc" value="Бухгалтер (3 чел.)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p1" value="1.0 Приём на работу:&lt;br&gt;сбор ПДн и документов" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
