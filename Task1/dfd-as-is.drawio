        <mxCell id="e_emp_1" value="F6.1 паспорт, СНИЛС, ИНН,&lt;br&gt;адрес, медкнижка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="emp" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p1_2" value="F6.2 личное дело&lt;br&gt;на бумаге" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p1_3" value="F6.3 оригиналы документов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p2_4" value="F6.4 сканы JPG / PDF&lt;br&gt;без шифрования" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_5" value="F6.5 табели и данные&lt;br&gt;сотрудника" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_acc_6" value="F6.6 доменная УЗ,&lt;br&gt;полный доступ к базе" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3_7" value="F6.7 начисления,&lt;br&gt;налоги, взносы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_8" value="F6.8 отчётность&lt;br&gt;(6-НДФЛ, РСВ)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="fns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3_9" value="F6.9 суммы к выплате" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4_10" value="F6.10 реестр «ФИО + счёт + сумма»&lt;br&gt;выгружается в файл вручную" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_oth_11" value="F6.11 сканы паспортов&lt;br&gt;доступны всем на шаре" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oth" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="risks" value="ЗОНЫ РИСКА В ПОТОКЕ&lt;br&gt;&lt;br&gt;R6.1 ПДн сотрудников не учтены как отдельная ИСПДн:&lt;br&gt;перечень данных, цели и сроки обработки&lt;br&gt;не задокументированы.&lt;br&gt;&lt;br&gt;R6.2 Сканы паспортов и СНИЛС на общем диске&lt;br&gt;без шифрования — готовый набор для мошенничества&lt;br&gt;и социальной инженерии.&lt;br&gt;&lt;br&gt;R6.3 Зарплатный реестр (банковская тайна)&lt;br&gt;выгружается в файл и передаётся вручную.&lt;br&gt;&lt;br&gt;R6.4 Медицинские книжки и справки сотрудников —&lt;br&gt;спец. категория ПДн, обрабатываются&lt;br&gt;без отдельного правового основания.&lt;br&gt;&lt;br&gt;R6.5 При росте штата в 5 раз ручной процесс&lt;br&gt;и файловая 1С становятся узким местом&lt;br&gt;и источником ошибок.&lt;br&gt;&lt;br&gt;R6.6 Нет процедуры удаления ПДн уволенных&lt;br&gt;по истечении срока хранения.&lt;br&gt;&lt;br&gt;R6.7 Нет разделения обязанностей: один бухгалтер&lt;br&gt;и заводит сотрудника, и начисляет, и выгружает реестр." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="100" width="420" height="760" as="geometry"/></mxCell>
        <mxCell id="legend" value="ЛЕГЕНДА (нотация Gane–Sarson)&lt;br&gt;• Синий прямоугольник — внешняя сущность (актор, организация)&lt;br&gt;• Зелёный овал — процесс обработки данных&lt;br&gt;• Жёлтый открытый прямоугольник — хранилище данных (Dn)&lt;br&gt;• Красный прямоугольник — внешняя ИТ-система / канал&lt;br&gt;• Красная пунктирная рамка — граница доверия (trust boundary)&lt;br&gt;• Синяя стрелка — штатный поток данных (Fx.y)&lt;br&gt;• Красная стрелка — поток с неконтролируемой передачей ПДн / врачебной тайны&lt;br&gt;Полное описание потоков — в файле Task1/data-flows.md" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="560" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
