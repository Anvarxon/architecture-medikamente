        <mxCell id="e_p1_3" value="F2.3 анамнез, жалобы, диагноз" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_pat_4" value="F2.4 паспорт, полис,&lt;br&gt;выписки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p1_5" value="F2.5 подпись согласия&lt;br&gt;на бумаге" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3_6" value="F2.6 скан JPG / PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_7" value="F2.7 ручное перекладывание файлов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p2_8" value="F2.8 файл медкарты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4_9" value="F2.9 файл в папку&lt;br&gt;«ФИО-ДатаРождения»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_oth_10" value="F2.10 чтение любой&lt;br&gt;медкарты по SMB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oth" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_oth_11" value="F2.11 чтение буфера сканов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oth" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_12" value="F2.12 выгрузка файлов" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p5_13" value="F2.13 копия на USB&lt;br&gt;и локальный диск" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d3_14" value="F2.14 пересылка&lt;br&gt;медкарты вовне" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_15" value="F2.15 повторный приём:&lt;br&gt;открытие всей истории пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="doc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="336"/><mxPoint x="170" y="336"/></Array><mxPoint as="offset" x="340" y="-22"/></mxGeometry></mxCell>
        <mxCell id="risks" value="ЗОНЫ РИСКА В ПОТОКЕ&lt;br&gt;&lt;br&gt;R2.1 ПДн в имени каталога (ФИО + дата рождения):&lt;br&gt;пациент идентифицируется без открытия файла,&lt;br&gt;имя попадает в индексы поиска и в резервные копии.&lt;br&gt;&lt;br&gt;R2.2 Нет правила «врач видит только своих пациентов»:&lt;br&gt;отсутствуют и RBAC, и ABAC — только доменная&lt;br&gt;аутентификация.&lt;br&gt;&lt;br&gt;R2.3 Буфер МФУ \\FS\scan$ доступен Everyone&lt;br&gt;и не очищается по расписанию.&lt;br&gt;&lt;br&gt;R2.4 Нет DLP: копирование на USB и отправка&lt;br&gt;во внешние каналы не блокируются и не детектируются.&lt;br&gt;&lt;br&gt;R2.5 Нет шифрования файлов, томов и резервных копий.&lt;br&gt;&lt;br&gt;R2.6 Нет аудита доступа к врачебной тайне —&lt;br&gt;прямое нарушение ст. 13 323-ФЗ и требований&lt;br&gt;приказа ФСТЭК № 21 (подсистема регистрации событий).&lt;br&gt;&lt;br&gt;R2.7 Бумажные согласия не связаны с электронными&lt;br&gt;данными: отозвать согласие и удалить данные нельзя.&lt;br&gt;&lt;br&gt;R2.8 Нет обезличивания: медицинские данные&lt;br&gt;хранятся только в идентифицированном виде,&lt;br&gt;аналитика на них невозможна без риска утечки." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="100" width="420" height="760" as="geometry"/></mxCell>
        <mxCell id="legend" value="ЛЕГЕНДА (нотация Gane–Sarson)&lt;br&gt;• Синий прямоугольник — внешняя сущность (актор, организация)&lt;br&gt;• Зелёный овал — процесс обработки данных&lt;br&gt;• Жёлтый открытый прямоугольник — хранилище данных (Dn)&lt;br&gt;• Красный прямоугольник — внешняя ИТ-система / канал&lt;br&gt;• Красная пунктирная рамка — граница доверия (trust boundary)&lt;br&gt;• Синяя стрелка — штатный поток данных (Fx.y)&lt;br&gt;• Красная стрелка — поток с неконтролируемой передачей ПДн / врачебной тайны&lt;br&gt;Полное описание потоков — в файле Task1/data-flows.md" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="560" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
