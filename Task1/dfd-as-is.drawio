        <mxCell id="b1" value="Граница доверия: FileServer \\FS\Pacients (NTFS ACL «Domain Users: Modify»), сетевой буфер МФУ" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;fontColor=#B85450;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="1072" height="596" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 2 (AS-IS). Медицинский приём, ведение медицинской карты и хранение документов" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Категории данных: специальная категория ПДн (анамнез, диагнозы, хронические заболевания), врачебная тайна, сканы документов, удостоверяющих личность." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Правовой контекст: 152-ФЗ ст. 10 (спец. категории), 323-ФЗ ст. 13, приказ ФСТЭК № 21 (меры защиты ИСПДн)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="doc" value="Медицинский специалист&lt;br&gt;(АРМ Windows: Word, Excel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pat" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d4" value="D4 | Бумажная карта&lt;br&gt;и согласие (шкаф в кабинете)" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p2" value="2.0 Заполнение медкарты&lt;br&gt;(Word / Excel вручную)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p1" value="1.0 Сбор анамнеза&lt;br&gt;и расширенной анкеты" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p3" value="3.0 Сканирование&lt;br&gt;(МФУ → сетевая папка)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p4" value="4.0 Раскладка файлов&lt;br&gt;в папку пациента" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d2" value="D2 | \\FS\scan$&lt;br&gt;буфер МФУ (Everyone)" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d1" value="D1 | \\FS\Pacients\ФИО-ДР\&lt;br&gt;JPG, PDF, XLSX, DOCX" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p5" value="5.0 Копирование&lt;br&gt;«для работы дома»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="oth" value="Прочие сотрудники:&lt;br&gt;20 админ. + 15 мед. = 35 УЗ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="d3" value="D3 | Локальные копии:&lt;br&gt;АРМ, USB, корзина" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="780" width="260" height="110" as="geometry"/></mxCell>
