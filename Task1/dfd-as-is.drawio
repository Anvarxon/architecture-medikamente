        <mxCell id="e_p3_9" value="F3.9 ручной перенос&lt;br&gt;в Excel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4_10" value="F3.10 ФИО + услуга + сумма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3_11" value="F3.11 данные о выручке" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="415"/><mxPoint x="700" y="835"/></Array><mxPoint as="offset" x="0" y="90"/></mxGeometry></mxCell>
        <mxCell id="e_p5_12" value="F3.12 проводки, закрытие смены" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_acc_13" value="F3.13 полный доступ&lt;br&gt;к файлу базы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_14" value="F3.14 чтение медицинской&lt;br&gt;номенклатуры бухгалтером" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_trade_15" value="F3.15 OLE: ТМЦ&lt;br&gt;и себестоимость" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="trade" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="risks" value="ЗОНЫ РИСКА В ПОТОКЕ&lt;br&gt;&lt;br&gt;R3.1 Связка «ФИО + наименование услуги» —&lt;br&gt;это сведения о состоянии здоровья (спец. категория&lt;br&gt;ПДн), а обрабатывается как обычная финансовая строка.&lt;br&gt;&lt;br&gt;R3.2 Нарушение минимизации: касса и бухгалтерия&lt;br&gt;видят медицинскую номенклатуру, хотя для учёта&lt;br&gt;достаточно обезличенного кода услуги.&lt;br&gt;&lt;br&gt;R3.3 Файловый режим 1С: доступ к сетевой папке = &lt;br&gt;доступ ко всей базе целиком, включая ПДн&lt;br&gt;пациентов и сотрудников; ролевая модель обходится.&lt;br&gt;&lt;br&gt;R3.4 Двойной учёт (Excel + 1С) — нет single source&lt;br&gt;of truth, страдает целостность данных, ручные ошибки.&lt;br&gt;&lt;br&gt;R3.5 Канал ККМ (TCP/IP + OLE) без шифрования&lt;br&gt;и без аутентификации сторон.&lt;br&gt;&lt;br&gt;R3.6 Общая учётная запись кассира — невозможно&lt;br&gt;установить исполнителя операции (нет неотказуемости).&lt;br&gt;&lt;br&gt;R3.7 Сканы договоров с паспортными данными&lt;br&gt;хранятся бессрочно, срок хранения не задан.&lt;br&gt;&lt;br&gt;R3.8 Нет сегментации сети: касса, бухгалтерия&lt;br&gt;и медицинские АРМ в одном L2-сегменте." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="100" width="420" height="760" as="geometry"/></mxCell>
        <mxCell id="legend" value="ЛЕГЕНДА (нотация Gane–Sarson)&lt;br&gt;• Синий прямоугольник — внешняя сущность (актор, организация)&lt;br&gt;• Зелёный овал — процесс обработки данных&lt;br&gt;• Жёлтый открытый прямоугольник — хранилище данных (Dn)&lt;br&gt;• Красный прямоугольник — внешняя ИТ-система / канал&lt;br&gt;• Красная пунктирная рамка — граница доверия (trust boundary)&lt;br&gt;• Синяя стрелка — штатный поток данных (Fx.y)&lt;br&gt;• Красная стрелка — поток с неконтролируемой передачей ПДн / врачебной тайны&lt;br&gt;Полное описание потоков — в файле Task1/data-flows.md" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="560" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
