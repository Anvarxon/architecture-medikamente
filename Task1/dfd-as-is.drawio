        <mxCell id="e_doc_1" value="F5.1 потребность&lt;br&gt;в препаратах" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="doc" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p1_2" value="F5.2 спецификация закупки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p2_3" value="F5.3 открытая почта:&lt;br&gt;номенклатура, цены,&lt;br&gt;контакты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sup_4" value="F5.4 поставка и накладные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sup" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="310"/><mxPoint x="550" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="e_wh_5" value="F5.5 общая УЗ в 1С" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wh" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3_6" value="F5.6 оприходование ТМЦ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d1"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-16"/></mxGeometry></mxCell>
        <mxCell id="e_p3_7" value="F5.7 скан накладной" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.71;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-16"/></mxGeometry></mxCell>
        <mxCell id="e_p4_8" value="F5.8 списание: препарат&lt;br&gt;+ кабинет + дата" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.6799999999999999;exitDx=0;exitDy=0;entryX=0;entryY=0.6799999999999999;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_9" value="F5.9 данные для проводок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="415"/><mxPoint x="740" y="835"/></Array></mxGeometry></mxCell>
        <mxCell id="e_p5_10" value="F5.10 OLE-обмен&lt;br&gt;без журналирования" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_acc_11" value="F5.11 учёт затрат" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_12" value="F5.12 прямой доступ к файлу базы по шаре" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="acc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="415"/></Array></mxGeometry></mxCell>
        <mxCell id="risks" value="ЗОНЫ РИСКА В ПОТОКЕ&lt;br&gt;&lt;br&gt;R5.1 Данные о списании препаратов на кабинет&lt;br&gt;и процедуру при сопоставлении с журналом приёма&lt;br&gt;позволяют восстановить диагноз пациента —&lt;br&gt;риск реидентификации по косвенным признакам.&lt;br&gt;&lt;br&gt;R5.2 Коммерческая тайна (цены, условия поставщиков)&lt;br&gt;хранится без грифа и без разграничения доступа.&lt;br&gt;&lt;br&gt;R5.3 OLE-обмен между 1С:Торговля и 1С:Бухгалтерия&lt;br&gt;не аутентифицируется и не журналируется —&lt;br&gt;внутренние потоки данных неконтролируемы.&lt;br&gt;&lt;br&gt;R5.4 Файловый режим 1С не поддерживает&lt;br&gt;разграничение на уровне записи и не выдержит&lt;br&gt;пятикратный рост объёма данных и числа филиалов.&lt;br&gt;&lt;br&gt;R5.5 ПДн контактных лиц поставщиков обрабатываются&lt;br&gt;без правового основания и не учтены в перечне ИСПДн.&lt;br&gt;&lt;br&gt;R5.6 Сканы первичных документов лежат на общем&lt;br&gt;диске без контроля целостности и версий." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="100" width="420" height="760" as="geometry"/></mxCell>
        <mxCell id="legend" value="ЛЕГЕНДА (нотация Gane–Sarson)&lt;br&gt;• Синий прямоугольник — внешняя сущность (актор, организация)&lt;br&gt;• Зелёный овал — процесс обработки данных&lt;br&gt;• Жёлтый открытый прямоугольник — хранилище данных (Dn)&lt;br&gt;• Красный прямоугольник — внешняя ИТ-система / канал&lt;br&gt;• Красная пунктирная рамка — граница доверия (trust boundary)&lt;br&gt;• Синяя стрелка — штатный поток данных (Fx.y)&lt;br&gt;• Красная стрелка — поток с неконтролируемой передачей ПДн / врачебной тайны&lt;br&gt;Полное описание потоков — в файле Task1/data-flows.md" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="560" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. AS-IS. Кадры и зарплата" id="d732953552">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
