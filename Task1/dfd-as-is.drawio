        <mxCell id="e_pat_1" value="F1.1 ПДн + жалоба&lt;br&gt;(устно / на бумаге)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6799999999999999;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_rec_2" value="F1.2 вход по УЗ AD&lt;br&gt;без MFA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.32;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p1_3" value="F1.3 черновик ПДн&lt;br&gt;на бумаге" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p1_4" value="F1.4 анкета пациента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p2_5" value="F1.5 строка в Excel:&lt;br&gt;ФИО, ДР, телефон,&lt;br&gt;e-mail — plain text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d1_6" value="F1.6 поиск пациента&lt;br&gt;(файл целиком на АРМ)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p3_7" value="F1.7 ФИО + услуга&lt;br&gt;+ время приёма" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6799999999999999;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_8" value="F1.8 чтение и правка&lt;br&gt;файла по SMB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="doc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_d2_9" value="F1.9 выборка&lt;br&gt;записей на завтра" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0;exitY=0.32;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4_10" value="F1.10 письмо врачу:&lt;br&gt;ФИО + услуга,&lt;br&gt;без шифрования" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4_11" value="F1.11 список пациентов&lt;br&gt;в личном телефоне" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="mob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_p4_12" value="F1.12 напоминание звонком / SMS с личного номера" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="pat2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="940"/><mxPoint x="1310" y="940"/></Array></mxGeometry></mxCell>
        <mxCell id="e_d3_13" value="F1.13 уведомление&lt;br&gt;о приёме" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="doc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="risks" value="ЗОНЫ РИСКА В ПОТОКЕ&lt;br&gt;&lt;br&gt;R1.1 Excel на общем диске: нет разграничения&lt;br&gt;доступа на уровне записи — любой из 35 сотрудников&lt;br&gt;читает весь список пациентов (нарушение&lt;br&gt;минимизации и принципа least privilege).&lt;br&gt;&lt;br&gt;R1.2 Нет журналирования доступа: факт чтения&lt;br&gt;или копирования файла не фиксируется,&lt;br&gt;расследование инцидента невозможно.&lt;br&gt;&lt;br&gt;R1.3 Нет шифрования at rest (том без BitLocker)&lt;br&gt;и in transit (SMB без обязательного шифрования&lt;br&gt;и подписывания).&lt;br&gt;&lt;br&gt;R1.4 Согласие на обработку ПДн не фиксируется&lt;br&gt;в системе, цель обработки не привязана к записи.&lt;br&gt;&lt;br&gt;R1.5 Теневые копии ПДн: бумажный журнал,&lt;br&gt;личный телефон, мессенджер — вне периметра&lt;br&gt;и вне учёта (ст. 18.1 и 19 152-ФЗ не выполняются).&lt;br&gt;&lt;br&gt;R1.6 Нет ретеншена: файлы хранятся бессрочно,&lt;br&gt;удаление по запросу субъекта технически&lt;br&gt;невыполнимо (ст. 21 152-ФЗ).&lt;br&gt;&lt;br&gt;R1.7 Нет неотказуемости: несколько сотрудников&lt;br&gt;работают под общими учётными записями.&lt;br&gt;&lt;br&gt;* Дубль внешней сущности «Пациент» показан&lt;br&gt;для читаемости диаграммы." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1900" y="100" width="420" height="760" as="geometry"/></mxCell>
        <mxCell id="legend" value="ЛЕГЕНДА (нотация Gane–Sarson)&lt;br&gt;• Синий прямоугольник — внешняя сущность (актор, организация)&lt;br&gt;• Зелёный овал — процесс обработки данных&lt;br&gt;• Жёлтый открытый прямоугольник — хранилище данных (Dn)&lt;br&gt;• Красный прямоугольник — внешняя ИТ-система / канал&lt;br&gt;• Красная пунктирная рамка — граница доверия (trust boundary)&lt;br&gt;• Синяя стрелка — штатный поток данных (Fx.y)&lt;br&gt;• Красная стрелка — поток с неконтролируемой передачей ПДн / врачебной тайны&lt;br&gt;Полное описание потоков — в файле Task1/data-flows.md" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="560" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. AS-IS. Приём и медкарта" id="d555448554">
