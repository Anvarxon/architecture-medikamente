        <mxCell id="b1" value="Граница доверия: ЛВС офиса + FileServer (SMB). Единственный контроль — доменная аутентификация AD, ACL «Domain Users: Change»" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;fontColor=#B85450;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="692" height="806" as="geometry"/></mxCell>
        <mxCell id="t_title" value="Процесс 1 (AS-IS). Запись пациента на приём к специалисту" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Категории данных: ПДн (ФИО, дата рождения, телефон, e-mail); специальная категория ПДн — сведения о состоянии здоровья (жалоба, профиль специалиста)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Правовой контекст: 152-ФЗ (ст. 9, 10, 18.1, 19), 323-ФЗ ст. 13 (врачебная тайна), ПП РФ № 1119 (1-й уровень защищённости ИСПДн)." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
