        <mxCell id="b1" value="Граница доверия: ЛВС офиса; 1С в файловом режиме (.1CD на общей шаре); ККМ по TCP/IP + OLE без TLS" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;fontColor=#B85450;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="394" y="110" width="692" height="1016" as="geometry"/></mxCell>
