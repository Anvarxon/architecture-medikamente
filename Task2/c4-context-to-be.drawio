        <mxCell id="iam" value="IAM&lt;br&gt;[Keycloak]&lt;br&gt;OIDC, MFA, SSO,&lt;br&gt;сервисные учётные записи" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="gw" value="API Gateway + WAF&lt;br&gt;[Kong / Envoy]&lt;br&gt;TLS 1.3, mTLS, rate limit,&lt;br&gt;валидация OpenAPI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="pdp" value="PDP&lt;br&gt;[OPA / Rego]&lt;br&gt;ABAC и RBAC,&lt;br&gt;политики как код" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#6A1B9A;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="260" height="110" as="geometry"/></mxCell>
