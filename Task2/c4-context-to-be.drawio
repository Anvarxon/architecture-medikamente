        <mxCell id="e_cl4_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.584;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl4" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_cl5_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.752;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl5" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_cl6_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.92;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl6" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lbl_cl" value="HTTPS, TLS 1.3, токен OIDC — единая точка входа для всех приложений" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="700" y="284" width="900" height="20" as="geometry"/></mxCell>
        <mxCell id="e_gw_7" value="проверка токена" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#7B1FA2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gw" target="iam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
