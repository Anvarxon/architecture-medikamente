        <mxCell id="bi" value="BI&lt;br&gt;[Superset / Metabase]&lt;br&gt;P&amp;L, ABC-анализ,&lt;br&gt;загрузка врачей" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="990" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="ml" value="ML / AI платформа&lt;br&gt;[Feature Store, MLflow]&lt;br&gt;обучение только&lt;br&gt;на обезличенных данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#43A047;strokeColor=#2E7D32;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="990" width="260" height="110" as="geometry"/></mxCell>
