<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="C4 L1. Контекст (TO-BE)" id="d812710815">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t_title" value="C4, уровень 1 — контекст целевой системы «Медикаменте» (TO-BE)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Единая медицинская платформа заменяет Excel, общий диск и ручные операции. Все внешние взаимодействия проходят через контролируемые шлюзы, а конфиденциальные данные — через PII Vault и PDP." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="Цвета: тёмно-синий — пользователи; синий — система в фокусе; серый — внешние системы и организации." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Записывается на приём, смотрит свои&lt;br&gt;анализы, заключения и договоры" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="rec" value="&lt;b&gt;Сотрудник ресепшена&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Ведёт запись, подтверждает визиты,&lt;br&gt;оформляет договоры" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="doc" value="&lt;b&gt;Медицинский специалист&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Ведёт ЭМК, назначает исследования,&lt;br&gt;смотрит результаты своих пациентов" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="cas" value="&lt;b&gt;Кассир&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Принимает оплату,&lt;br&gt;работает с кодами услуг" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="acc" value="&lt;b&gt;Бухгалтер&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Учёт выручки, кадры, зарплата,&lt;br&gt;налоговая отчётность" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="wh" value="&lt;b&gt;Сотрудник склада&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Учёт ТМЦ, закупки,&lt;br&gt;списание расходников" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1415" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="dpo" value="&lt;b&gt;Офицер ИБ / DPO&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Политики доступа, реестр обработки,&lt;br&gt;разбор инцидентов, аудит" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="ana" value="&lt;b&gt;Аналитик данных / ML-инженер&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;BI-отчётность и модели&lt;br&gt;только на обезличенных данных" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1965" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="adm" value="&lt;b&gt;Администратор платформы&lt;/b&gt;&lt;br&gt;[Человек]&lt;br&gt;Эксплуатация, мониторинг,&lt;br&gt;управление ключами и доступами" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2240" y="120" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="sys" value="&lt;b&gt;Медицинская платформа «Медикаменте»&lt;/b&gt;&lt;br&gt;[Программная система]&lt;br&gt;Единая система записи, ЭМК, платежей, интеграций и аналитики. Реализует Privacy by Design: минимизация данных, псевдонимизация, шифрование, управление согласиями, авторизация ABAC, аудит доступа и тегирование данных." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0B4884;strokeColor=#062F55;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="1900" height="220" as="geometry"/></mxCell>
        <mxCell id="lab" value="&lt;b&gt;Лаборатория анализов&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Партнёрское API: заказ исследований&lt;br&gt;и выдача результатов по псевдониму" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="psp" value="&lt;b&gt;Платёжный провайдер / банк-эквайер&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Приём платежей, токен карты;&lt;br&gt;данные карт не хранятся в компании" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="315" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="kkm" value="&lt;b&gt;ККМ и ОФД&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Фискализация чеков,&lt;br&gt;передача данных в ФНС" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="b1c" value="&lt;b&gt;1С:Бухгалтерия предприятия&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Регламентированный учёт,&lt;br&gt;клиент-серверный режим" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="865" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="t1c" value="&lt;b&gt;1С:Торговля и склад&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Учёт ТМЦ,&lt;br&gt;клиент-серверный режим" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="notif" value="&lt;b&gt;Провайдер уведомлений&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Push, SMS, голосовой робот&lt;br&gt;(договор поручения на обработку)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1415" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="bank" value="&lt;b&gt;Банк (зарплатный проект)&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Зарплатный реестр&lt;br&gt;по защищённому каналу с ЭП" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="fns" value="&lt;b&gt;ФНС / СФР&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Отчётность по ТКС" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1965" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="ca" value="&lt;b&gt;Удостоверяющий центр / КриптоПро&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Электронная подпись документов&lt;br&gt;и сертификаты ГОСТ TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2240" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="miac" value="&lt;b&gt;Региональный МИАЦ / ЕГИСЗ&lt;/b&gt;&lt;br&gt;[Внешняя система]&lt;br&gt;Обмен медицинскими сведениями&lt;br&gt;(перспектива)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5F5F5F;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2515" y="800" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="e_pat_1" value="Запись на приём, просмотр&lt;br&gt;своих данных&lt;br&gt;[HTTPS, TLS 1.3, OIDC + MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_rec_2" value="Управление расписанием&lt;br&gt;[HTTPS, OIDC + MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.074;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_doc_3" value="Ведение ЭМК&lt;br&gt;[HTTPS, OIDC + MFA]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.218;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="doc" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_cas_4" value="Приём оплаты&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.363;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cas" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_acc_5" value="Финансовый и кадровый учёт&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.508;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wh_6" value="Учёт ТМЦ&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.653;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wh" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_dpo_7" value="Политики, аудит,&lt;br&gt;реестр обработки ПДн&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.797;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dpo" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ana_8" value="BI и ML только&lt;br&gt;на обезличенных данных&lt;br&gt;[HTTPS, SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.942;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ana" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_adm_9" value="Эксплуатация&lt;br&gt;и мониторинг&lt;br&gt;[HTTPS, SSH]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_10" value="Заказ исследования по псевдониму&lt;br&gt;и приём результата&lt;br&gt;[REST, mTLS, подпись]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="lab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_11" value="Оплата и возврат&lt;br&gt;[REST, TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.074;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="psp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_12" value="Фискализация чека&lt;br&gt;[защищённый шлюз, mTLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.218;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="kkm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_13" value="Проводки и выручка&lt;br&gt;без медицинских данных&lt;br&gt;[Kafka, REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.363;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="b1c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_14" value="Движение ТМЦ&lt;br&gt;[Kafka, REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.508;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="t1c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_15" value="Напоминания и подтверждения&lt;br&gt;[REST, TLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.653;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="notif"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_16" value="Зарплатный реестр&lt;br&gt;[канал банка, ЭП]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.797;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_17" value="Отчётность&lt;br&gt;[ТКС, ЭП]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.942;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="fns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_18" value="Подпись документов&lt;br&gt;[CAdES, ГОСТ]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="ca"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sys_19" value="Обмен медицинскими&lt;br&gt;сведениями [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="miac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="note1" value="НОВЫЕ БЛОКИ, ОБЕСПЕЧИВАЮЩИЕ PRIVACY BY DESIGN (детализация — на странице «C4 L2»)&lt;br&gt;&lt;br&gt;1. IAM (Keycloak) — единая аутентификация OIDC + MFA, отказ от общих учётных записей.&lt;br&gt;2. PDP на OPA — авторизация ABAC/RBAC: «свой пациент», «свой филиал», «своя роль».&lt;br&gt;3. PII Vault + KMS/HSM — токенизация прямых идентификаторов и хранение ключей.&lt;br&gt;4. Consent Service — согласия, цели обработки, отзыв, сроки хранения.&lt;br&gt;5. Data Catalog + Tagging + Lineage — классификация данных и прослеживаемость.&lt;br&gt;6. Audit Log (WORM) + SIEM/DLP — журнал доступа, детект аномалий, контроль утечек.&lt;br&gt;7. Retention Service — автоудаление и crypto-shredding по сроку и по отзыву согласия.&lt;br&gt;8. Egress Gateway — единая точка выхода данных наружу с контрактами и квотами.&lt;br&gt;9. Аналитический слой — Data Lake с обезличиванием: BI, ML и LLM без доступа к ПДн." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1120" height="300" as="geometry"/></mxCell>
        <mxCell id="note2" value="ПРИНЦИПЫ, ЗАЛОЖЕННЫЕ В КОНТЕКСТ&lt;br&gt;&lt;br&gt;• Privacy by Design и by Default: минимальный набор данных на каждом интерфейсе,&lt;br&gt;  расширение состава данных возможно только через изменение контракта.&lt;br&gt;• Data Minimization: наружу уходит псевдоним, а не ФИО; в финансовый контур —&lt;br&gt;  код услуги, а не диагноз.&lt;br&gt;• Zero Trust: любое обращение (внутреннее и внешнее) проходит аутентификацию,&lt;br&gt;  авторизацию в PDP и журналирование.&lt;br&gt;• Data Lineage: для каждого элемента данных известно происхождение, получатели&lt;br&gt;  и срок хранения — это делает выполнимыми права субъекта ПДн.&lt;br&gt;• Хранение и обработка ПДн граждан РФ — на территории РФ (ст. 18 ч. 5 152-ФЗ)." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="1000" width="1000" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C4 L2. Контейнеры (MVP)" id="d1029009524">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bana" value="Аналитический слой (privacy-preserving analytics)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#2E7D32;fontColor=#2E7D32;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="14" y="950" width="2212" height="176" as="geometry"/></mxCell>
        <mxCell id="bdata" value="Слой данных (операционные хранилища)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B8860B;fontColor=#B8860B;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="14" y="740" width="2212" height="176" as="geometry"/></mxCell>
        <mxCell id="bdom" value="Доменные сервисы (bounded contexts)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#2E6295;fontColor=#2E6295;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="14" y="530" width="2212" height="176" as="geometry"/></mxCell>
        <mxCell id="bsec" value="Периметр и privacy-контроль (Privacy by Design)" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#7B1FA2;fontColor=#7B1FA2;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="14" y="320" width="2212" height="176" as="geometry"/></mxCell>
        <mxCell id="bcl" value="Клиентские приложения" style="rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#2E6295;fontColor=#2E6295;verticalAlign=top;align=left;spacing=12;fontSize=13;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="14" y="110" width="2212" height="176" as="geometry"/></mxCell>
        <mxCell id="t_title" value="C4, уровень 2 — контейнеры целевой платформы «Медикаменте» (объём MVP + задел на финальное состояние)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="t_sub" value="Слои: клиентские приложения → периметр и privacy-контроль → доменные сервисы → слой данных → аналитический слой. Блоки Privacy by Design выделены фиолетовым, аналитический слой — зелёным." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="t_sub2" value="В объём MVP (2 месяца) входят: портал пациента, портал ресепшена, Appointment Service, Notification Service, IAM, PDP, PII Vault, Consent, Audit." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/></mxCell>
        <mxCell id="cl1" value="Портал пациента&lt;br&gt;[SPA, TypeScript]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cl2" value="Мобильное приложение&lt;br&gt;[iOS / Android]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cl3" value="Портал ресепшена&lt;br&gt;[SPA]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cl4" value="Портал врача (ЭМК)&lt;br&gt;[SPA]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="cl5" value="Портал кассы&lt;br&gt;и бухгалтерии [SPA]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="260" height="110" as="geometry"/></mxCell>
