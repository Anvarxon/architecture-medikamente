        <mxCell id="e_cl1_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#1F6FB2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl1" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
